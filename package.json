{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "next dev --experimental-https --experimental-https-key ./certificates/key.pem --experimental-https-cert ./certificates/cert.pem",
    "build": "next build",
    "postbuild": "next-sitemap && tsx generate-rss.ts && touch out/.nojekyll && echo 'sogo.dev' > out/CNAME",
    "start": "next start",
    "lint": "eslint .",
    "requestIndexing": "tsx request-indexing.ts",
    "vectorize": "tsx vectorize.ts",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@next/third-parties": "16.4.5",
    "@noroch/like-widget": "^1.0.2",
    "@tailwindcss/postcss": "^4.1.18",
    "googleapis": "^189.0.0",
    "gray-matter": "^4.0.3",
    "lodash": "^4.17.21",
    "next": "16.4.5",
    "next-sitemap": "^3.1.55",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "scheduler": "^0.28.0",
    "toml": "^5.0.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.0.0",
    "@langchain/core": "^1.2.5",
    "@langchain/openai": "^1.5.6",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash": "^4.17.23",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "react-syntax-highlighter": "^16.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}